{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "alpha-pwa/frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "alpha-pwa/backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint(analyze-text|analyze-jobs|chat|upload|fetch-url|transcribe)",
      "destination": "https://plt-backend.onrender.com/api/:endpoint"
    },
    {
      "source": "/api/analyze-jobs/:jobId",
      "destination": "https://plt-backend.onrender.com/api/analyze-jobs/:jobId"
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
